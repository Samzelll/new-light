      replacement_content: "\"use client\";\n\nimport React, { useState } from \'react\';\nimport { LiveBattle } from \'@/components/contest/LiveBattle\';\nimport { GroupVoting } from \'@/components/contest/GroupVoting\';\nimport type { Contest } from \'@/features/contests/types\';\n\n// Mock data to render the feed\nconst mockContests: Contest[] = [\n  {\n    id: \'1\',\n    title: \'Best Frontend Framework 2024\',\n    description: \'Vote for the best modern frontend framework.\',\n    creatorId: \'admin1\',\n    status: \'active\',\n    type: \'battle\',\n    category: \'Technology\',\n    createdAt: new Date().toISOString(),\n    participants: [\n      { id: \'p1\', contestId: \'1\', name: \'React\', image: \'https://picsum.photos/seed/react/400/400\', votes: 1500 },\n      { id: \'p2\', contestId: \'1\', name: \'Vue\', image: \'https://picsum.photos/seed/vue/400/400\', votes: 800 },\n    ],\n    rules: {\n      votingStrategy: \'one_vote\',\n      duration: 3600,\n      requiresAuth: false,\n    },\n    metrics: { totalVotes: 2300, views: 5000, shares: 120 }\n  },\n  {\n    id: \'2\',\n    title: \'Top AI Assistants\',\n    description: \'Which AI assistant do you use the most?\',\n    creatorId: \'admin2\',\n    status: \'active\',\n    type: \'group\',\n    category: \'Technology\',\n    createdAt: new Date().toISOString(),\n    participants: [\n      { id: \'p3\', contestId: \'2\', name: \'ChatGPT\', image: \'https://picsum.photos/seed/chatgpt/400/400\', votes: 2000 },\n      { id: \'p4\', contestId: \'2\', name: \'Claude\', image: \'https://picsum.photos/seed/claude/400/400\', votes: 1800 },\n      { id: \'p5\', contestId: \'2\', name: \'Gemini\', image: \'https://picsum.photos/seed/gemini/400/400\', votes: 1900 },\n    ],\n    rules: {\n      votingStrategy: \'ranked\',\n      duration: 7200,\n      requiresAuth: true,\n    },\n    metrics: { totalVotes: 5700, views: 10000, shares: 300 }\n  }\n];\n\nexport default function HomePage() {\n  const [contests] = useState<Contest[]>(mockContests);\n\n  return (\n    <div className=\"p-4 md:p-8 max-w-4xl mx-auto space-y-8\">\n      <header className=\"mb-8\">\n        <h1 className=\"text-3xl font-bold tracking-tight\">Trending Contests</h1>\n        <p className=\"text-muted-foreground mt-2\">Join the debate and cast your vote on trending topics.</p>\n      </header>\n\n      <div className=\"space-y-12\">\n        {contests.map((contest) => (\n          <div key={contest.id} className=\"bg-card rounded-xl border shadow-sm overflow-hidden\">\n            <div className=\"p-6\">\n              <div className=\"flex items-center justify-between mb-4\">\n                <span className=\"inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold bg-primary/10 text-primary\">\n                  {contest.category}\n                </span>\n                <span className=\"text-sm text-muted-foreground\">\n                  {contest.metrics.totalVotes.toLocaleString()} votes\n                </span>\n              </div>\n              <h2 className=\"text-2xl font-semibold mb-2\">{contest.title}</h2>\n              <p className=\"text-muted-foreground mb-6\">{contest.description}</p>\n              \n              {contest.type === \'battle\' ? (\n                <LiveBattle contestId={contest.id} participants={contest.participants} userTrustScore={50} />\n              ) : (\n                <GroupVoting contestId={contest.id} participants={contest.participants} userTrustScore={50} />\n              )}\n            </div>\n          </div>\n        ))}\n      </div>\n    </div>\n  );\n}"
    }
