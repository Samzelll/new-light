    instruction: "Update Tailwind v4 theme definitions in globals.css so all surface, brand, card, and accent classes generate properly."
    replacement_infos {
      original_chunk {
        target_content: "@import \"tailwindcss\";\n\n@theme {\n  --color-background: 0 0% 100%;\n  --color-foreground: 222.2 84% 4.9%;\n\n  --color-card: 0 0% 100%;\n  --color-card-foreground: 222.2 84% 4.9%;\n\n  --color-primary: 222.2 47.4% 11.2%;\n  --color-primary-foreground: 210 40% 98%;\n\n  --color-secondary: 210 40% 96.1%;\n  --color-secondary-foreground: 222.2 47.4% 11.2%;\n\n  --color-muted: 210 40% 96.1%;\n  --color-muted-foreground: 215.4 16.3% 46.9%;\n\n  --color-accent: 210 40% 96.1%;\n  --color-accent-foreground: 222.2 47.4% 11.2%;\n\n  --color-destructive: 0 84.2% 60.2%;\n  --color-destructive-foreground: 210 40% 98%;\n\n  --color-border: 214.3 31.8% 91.4%;\n  --color-input: 214.3 31.8% 91.4%;\n  --color-ring: 222.2 84% 4.9%;\n\n  --radius: 0.5rem;\n}\n\n@layer base {\n  :root {\n    --background: #000000;\n    --foreground: #ffffff;\n    \n    --surface-900: #121212;\n    --surface-800: #1a1a1a;\n    --surface-700: #2a2a2a;\n    --surface-600: #333333;\n    \n    --brand-500: #6366f1;\n    --brand-600: #4f46e5;\n    \n    --accent-red: #ef4444;\n    --accent-green: #22c55e;\n  }\n}"
        replacement_content: "@import \"tailwindcss\";\n\n@theme {\n  --color-background: #09090b;\n  --color-foreground: #f8fafc;\n\n  --color-card: #121215;\n  --color-card-foreground: #f8fafc;\n\n  --color-surface-900: #0a0a0c;\n  --color-surface-800: #141418;\n  --color-surface-700: #22222a;\n  --color-surface-600: #2f2f3a;\n\n  --color-primary: #6366f1;\n  --color-primary-foreground: #ffffff;\n\n  --color-brand-400: #818cf8;\n  --color-brand-500: #6366f1;\n  --color-brand-600: #4f46e5;\n\n  --color-secondary: #27272a;\n  --color-secondary-foreground: #f8fafc;\n\n  --color-muted: #18181b;\n  --color-muted-foreground: #94a3b8;\n\n  --color-accent: #27272a;\n  --color-accent-foreground: #f8fafc;\n\n  --color-accent-red: #ef4444;\n  --color-accent-green: #22c55e;\n\n  --color-destructive: #ef4444;\n  --color-destructive-foreground: #ffffff;\n\n  --color-border: #27272a;\n  --color-input: #27272a;\n  --color-ring: #6366f1;\n\n  --radius-sm: 0.375rem;\n  --radius-md: 0.5rem;\n  --radius-lg: 0.75rem;\n  --radius-xl: 1rem;\n}\n\n@layer base {\n  :root {\n    --background: #09090b;\n    --foreground: #f8fafc;\n    \n    --surface-900: #0a0a0c;\n    --surface-800: #141418;\n    --surface-700: #22222a;\n    --surface-600: #2f2f3a;\n    \n    --brand-500: #6366f1;\n    --brand-600: #4f46e5;\n    \n    --accent-red: #ef4444;\n    --accent-green: #22c55e;\n  }\n}"
