    command_line: "cat << \'EOF\' > src/app/globals.css\n@import \"tailwindcss\";\n\n@theme {\n  --color-background: 0 0% 100%;\n  --color-foreground: 222.2 84% 4.9%;\n\n  --color-card: 0 0% 100%;\n  --color-card-foreground: 222.2 84% 4.9%;\n\n  --color-primary: 222.2 47.4% 11.2%;\n  --color-primary-foreground: 210 40% 98%;\n\n  --color-secondary: 210 40% 96.1%;\n  --color-secondary-foreground: 222.2 47.4% 11.2%;\n\n  --color-muted: 210 40% 96.1%;\n  --color-muted-foreground: 215.4 16.3% 46.9%;\n\n  --color-accent: 210 40% 96.1%;\n  --color-accent-foreground: 222.2 47.4% 11.2%;\n\n  --color-destructive: 0 84.2% 60.2%;\n  --color-destructive-foreground: 210 40% 98%;\n\n  --color-border: 214.3 31.8% 91.4%;\n  --color-input: 214.3 31.8% 91.4%;\n  --color-ring: 222.2 84% 4.9%;\n\n  --radius: 0.5rem;\n}\n\n@layer base {\n  :root {\n    --background: #000000;\n    --foreground: #ffffff;\n    \n    --surface-900: #121212;\n    --surface-800: #1a1a1a;\n    --surface-700: #2a2a2a;\n    --surface-600: #333333;\n    \n    --brand-500: #6366f1;\n    --brand-600: #4f46e5;\n    \n    --accent-red: #ef4444;\n    --accent-green: #22c55e;\n  }\n}\n\nbody {\n  background-color: var(--background);\n  color: var(--foreground);\n}\n\n.card {\n  background-color: var(--surface-800);\n  border: 1px solid var(--surface-700);\n  border-radius: 1rem;\n}\n\n.btn {\n  padding: 0.5rem 1rem;\n  border-radius: 0.5rem;\n  font-weight: 600;\n  cursor: pointer;\n  transition: all 0.2s;\n}\n\n.btn-primary {\n  background-color: var(--brand-500);\n  color: white;\n}\n\n.btn-primary:hover {\n  background-color: var(--brand-600);\n}\n\n/* Custom app shell layout */\n.app-shell {\n  display: flex;\n  height: 100vh;\n  width: 100vw;\n  overflow: hidden;\n}\n\n.app-shell-desktop-nav {\n  display: none;\n}\n\n.app-shell-main {\n  flex: 1;\n  overflow-y: auto;\n  padding-bottom: 64px; /* Space for bottom nav */\n}\n\n.app-shell-bottom-nav {\n  position: fixed;\n  bottom: 0;\n  left: 0;\n  right: 0;\n  height: 64px;\n  background-color: var(--surface-900);\n  border-top: 1px solid var(--surface-700);\n  display: flex;\n  align-items: center;\n  justify-content: space-around;\n  z-index: 50;\n}\n\n@media (min-width: 768px) {\n  .app-shell-desktop-nav {\n    display: block;\n    width: 250px;\n    border-right: 1px solid var(--surface-700);\n    flex-shrink: 0;\n    overflow-y: auto;\n    background-color: var(--surface-900);\n  }\n  .app-shell-main {\n    padding-bottom: 0;\n  }\n  .app-shell-bottom-nav {\n    display: none;\n  }\n}\n\n.sidenav {\n  height: 100%;\n  display: flex;\n  flex-direction: column;\n  padding: 1.5rem;\n}\n\n.sidenav-logo {\n  display: flex;\n  align-items: center;\n  gap: 0.75rem;\n  margin-bottom: 2rem;\n}\n\n.sidenav-logo-icon {\n  background: var(--brand-500);\n  border-radius: 8px;\n  padding: 8px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.sidenav-logo-title {\n  font-weight: 700;\n  font-size: 1.125rem;\n}\n\n.sidenav-logo-sub {\n  font-size: 0.75rem;\n  color: #9ca3af;\n}\n\n.sidenav-items {\n  display: flex;\n  flex-direction: column;\n  gap: 0.5rem;\n  flex: 1;\n}\n\n.sidenav-link {\n  display: flex;\n  align-items: center;\n  gap: 1rem;\n  padding: 0.75rem 1rem;\n  border-radius: 8px;\n  color: #9ca3af;\n  transition: all 0.2s;\n  position: relative;\n}\n\n.sidenav-link:hover {\n  background: var(--surface-700);\n  color: white;\n}\n\n.sidenav-link.active {\n  background: var(--surface-700);\n  color: white;\n  font-weight: 500;\n}\n\n.sidenav-link-icon {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 24px;\n  height: 24px;\n}\n\n.sidenav-link-dot {\n  position: absolute;\n  right: 1rem;\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background: var(--brand-500);\n}\n\n.sidenav-user-card {\n  display: flex;\n  align-items: center;\n  gap: 1rem;\n  padding: 1rem;\n  border-radius: 12px;\n  background: var(--surface-700);\n  margin-top: auto;\n}\n\n.sidenav-user-avatar {\n  width: 40px;\n  height: 40px;\n  border-radius: 50%;\n  background: var(--brand-500);\n  color: white;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-weight: 600;\n  font-size: 1.125rem;\n}\n\n.sidenav-user-info {\n  flex: 1;\n  min-width: 0;\n}\n\n.sidenav-user-name {\n  font-weight: 600;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.sidenav-user-role {\n  font-size: 0.75rem;\n  color: #9ca3af;\n  text-transform: capitalize;\n}\n\n.sidenav-signin-btn {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 0.5rem;\n  padding: 0.875rem;\n  background: var(--brand-500);\n  color: white;\n  border-radius: 8px;\n  font-weight: 500;\n  margin-top: auto;\n  transition: opacity 0.2s;\n}\n\n.sidenav-signin-btn:hover {\n  opacity: 0.9;\n}\nEOF"
