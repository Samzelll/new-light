    replacement_chunks {
      replacement_content: "@tailwind base;\n@tailwind components;\n@tailwind utilities;\n\n@layer base {\n  :root {\n    --background: 0 0% 100%;\n    --foreground: 222.2 84% 4.9%;\n\n    --card: 0 0% 100%;\n    --card-foreground: 222.2 84% 4.9%;\n\n    --popover: 0 0% 100%;\n    --popover-foreground: 222.2 84% 4.9%;\n\n    --primary: 222.2 47.4% 11.2%;\n    --primary-foreground: 210 40% 98%;\n\n    --secondary: 210 40% 96.1%;\n    --secondary-foreground: 222.2 47.4% 11.2%;\n\n    --muted: 210 40% 96.1%;\n    --muted-foreground: 215.4 16.3% 46.9%;\n\n    --accent: 210 40% 96.1%;\n    --accent-foreground: 222.2 47.4% 11.2%;\n\n    --destructive: 0 84.2% 60.2%;\n    --destructive-foreground: 210 40% 98%;\n\n    --border: 214.3 31.8% 91.4%;\n    --input: 214.3 31.8% 91.4%;\n    --ring: 222.2 84% 4.9%;\n\n    --radius: 0.5rem;\n  }\n\n  .dark {\n    --background: 222.2 84% 4.9%;\n    --foreground: 210 40% 98%;\n\n    --card: 222.2 84% 4.9%;\n    --card-foreground: 210 40% 98%;\n\n    --popover: 222.2 84% 4.9%;\n    --popover-foreground: 210 40% 98%;\n\n    --primary: 210 40% 98%;\n    --primary-foreground: 222.2 47.4% 11.2%;\n\n    --secondary: 217.2 32.6% 17.5%;\n    --secondary-foreground: 210 40% 98%;\n\n    --muted: 217.2 32.6% 17.5%;\n    --muted-foreground: 215 20.2% 65.1%;\n\n    --accent: 217.2 32.6% 17.5%;\n    --accent-foreground: 210 40% 98%;\n\n    --destructive: 0 62.8% 30.6%;\n    --destructive-foreground: 210 40% 98%;\n\n    --border: 217.2 32.6% 17.5%;\n    --input: 217.2 32.6% 17.5%;\n    --ring: 212.7 26.8% 83.9%;\n  }\n}\n\n@layer base {\n  * {\n    @apply border-border;\n  }\n  body {\n    @apply bg-background text-foreground;\n  }\n}\n\n/* Custom app shell layout */\n.app-shell {\n  display: flex;\n  height: 100vh;\n  width: 100vw;\n  overflow: hidden;\n}\n\n.app-shell-desktop-nav {\n  display: none;\n}\n\n.app-shell-main {\n  flex: 1;\n  overflow-y: auto;\n  padding-bottom: 64px; /* Space for bottom nav */\n}\n\n.app-shell-bottom-nav {\n  position: fixed;\n  bottom: 0;\n  left: 0;\n  right: 0;\n  height: 64px;\n  background-color: var(--background);\n  border-top: 1px solid var(--border);\n  display: flex;\n  align-items: center;\n  justify-content: space-around;\n  z-index: 50;\n}\n\n@media (min-width: 768px) {\n  .app-shell-desktop-nav {\n    display: block;\n    width: 250px;\n    border-right: 1px solid var(--border);\n    flex-shrink: 0;\n    overflow-y: auto;\n  }\n  .app-shell-main {\n    padding-bottom: 0;\n  }\n  .app-shell-bottom-nav {\n    display: none;\n  }\n}\n\n.sidenav {\n  height: 100%;\n  display: flex;\n  flex-direction: column;\n  padding: 1.5rem;\n}\n\n.sidenav-logo {\n  display: flex;\n  align-items: center;\n  gap: 0.75rem;\n  margin-bottom: 2rem;\n}\n\n.sidenav-logo-icon {\n  background: var(--primary);\n  border-radius: 8px;\n  padding: 8px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.sidenav-logo-title {\n  font-weight: 700;\n  font-size: 1.125rem;\n}\n\n.sidenav-logo-sub {\n  font-size: 0.75rem;\n  color: var(--muted-foreground);\n}\n\n.sidenav-items {\n  display: flex;\n  flex-direction: column;\n  gap: 0.5rem;\n  flex: 1;\n}\n\n.sidenav-link {\n  display: flex;\n  align-items: center;\n  gap: 1rem;\n  padding: 0.75rem 1rem;\n  border-radius: 8px;\n  color: var(--muted-foreground);\n  transition: all 0.2s;\n  position: relative;\n}\n\n.sidenav-link:hover {\n  background: var(--secondary);\n  color: var(--foreground);\n}\n\n.sidenav-link.active {\n  background: var(--secondary);\n  color: var(--foreground);\n  font-weight: 500;\n}\n\n.sidenav-link-icon {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 24px;\n  height: 24px;\n}\n\n.sidenav-link-dot {\n  position: absolute;\n  right: 1rem;\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background: var(--primary);\n}\n\n.sidenav-user-card {\n  display: flex;\n  align-items: center;\n  gap: 1rem;\n  padding: 1rem;\n  border-radius: 12px;\n  background: var(--secondary);\n  margin-top: auto;\n}\n\n.sidenav-user-avatar {\n  width: 40px;\n  height: 40px;\n  border-radius: 50%;\n  background: var(--primary);\n  color: var(--primary-foreground);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-weight: 600;\n  font-size: 1.125rem;\n}\n\n.sidenav-user-info {\n  flex: 1;\n  min-width: 0;\n}\n\n.sidenav-user-name {\n  font-weight: 600;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.sidenav-user-role {\n  font-size: 0.75rem;\n  color: var(--muted-foreground);\n  text-transform: capitalize;\n}\n\n.sidenav-signin-btn {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 0.5rem;\n  padding: 0.875rem;\n  background: var(--primary);\n  color: var(--primary-foreground);\n  border-radius: 8px;\n  font-weight: 500;\n  margin-top: auto;\n  transition: opacity 0.2s;\n}\n\n.sidenav-signin-btn:hover {\n  opacity: 0.9;\n}\n"
