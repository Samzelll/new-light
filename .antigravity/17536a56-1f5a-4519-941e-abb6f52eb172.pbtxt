      full: "\"use client\";import React, { useState } from \'react\';import { LiveBattle } from \'@/components/contest/LiveBattle\';import { GroupVoting } from \'@/components/contest/GroupVoting\';import type { Contest } from \'@/features/contests/types\';// Mock data to render the feedconst mockContests: Contest[] = [  {    id: \'1\',    title: \'Best Frontend Framework 2024\',    description: \'Vote for the best modern frontend framework.\',    creatorId: \'admin1\',    status: \'active\',    type: \'battle\',    category: \'Technology\',    createdAt: new Date().toISOString(),    participants: [      { id: \'p1\', contestId: \'1\', name: \'React\', submission_data: { photos: [\'https://picsum.photos/seed/react/400/400\'] }, votes: 1500 },      { id: \'p2\', contestId: \'1\', name: \'Vue\', submission_data: { photos: [\'https://picsum.photos/seed/vue/400/400\'] }, votes: 800 },    ],    rules: {      votingStrategy: \'one_vote\',      duration: 3600,      requiresAuth: false,    },    metrics: { totalVotes: 2300, views: 5000, shares: 120 }  },  {    id: \'2\',    title: \'Top AI Assistants\',    description: \'Which AI assistant do you use the most?\',    creatorId: \'admin2\',    status: \'active\',    type: \'group\',    category: \'Technology\',    createdAt: new Date().toISOString(),    participants: [      { id: \'p3\', contestId: \'2\', name: \'ChatGPT\', submission_data: { photos: [\'https://picsum.photos/seed/chatgpt/400/400\'] }, votes: 2000 },      { id: \'p4\', contestId: \'2\', name: \'Claude\', submission_data: { photos: [\'https://picsum.photos/seed/claude/400/400\'] }, votes: 1800 },      { id: \'p5\', contestId: \'2\', name: \'Gemini\', submission_data: { photos: [\'https://picsum.photos/seed/gemini/400/400\'] }, votes: 1900 },    ],    rules: {      votingStrategy: \'ranked\',      duration: 7200,      requiresAuth: true,    },    metrics: { totalVotes: 5700, views: 10000, shares: 300 }  }];export default function HomePage() {  const [contests] = useState<Contest[]>(mockContests);  return (    <div className=\"p-4 md:p-8 max-w-4xl mx-auto space-y-8\">      <header className=\"mb-8\">        <h1 className=\"text-3xl font-bold tracking-tight\">Trending Contests</h1>        <p className=\"text-muted-foreground mt-2\">Join the debate and cast your vote on trending topics.</p>      </header>      <div className=\"space-y-12\">        {contests.map((contest) => (          <div key={contest.id} className=\"bg-card rounded-xl border shadow-sm overflow-hidden\">            <div className=\"p-6\">              <div className=\"flex items-center justify-between mb-4\">                <span className=\"inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold bg-primary/10 text-primary\">                  {contest.category}                </span>                <span className=\"text-sm text-muted-foreground\">                  {contest.metrics.totalVotes.toLocaleString()} votes                </span>              </div>              <h2 className=\"text-2xl font-semibold mb-2\">{contest.title}</h2>              <p className=\"text-muted-foreground mb-6\">{contest.description}</p>                            {contest.type === \'battle\' ? (                <LiveBattle contestId={contest.id} participants={contest.participants} userTrustScore={50} />              ) : (                <GroupVoting contestId={contest.id} participants={contest.participants} userTrustScore={50} />              )}            </div>          </div>        ))}      </div>    </div>  );}"
    }
