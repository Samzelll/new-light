 useState<Contest[]>(mockContests);  return (    <div className=\"p-4 md:p-8 max-w-4xl mx-auto space-y-8\">      <header className=\"mb-8\">        <h1 className=\"text-3xl font-bold tracking-tight\">Trending Contests</h1>        <p className=\"text-muted-foreground mt-2\">Join the debate and cast your vote on trending topics.</p>      </header>      <div className=\"space-y-12\">        {contests.map((contest) => (          <div key={contest.id} className=\"bg-card rounded-xl border shadow-sm overflow-hidden\">            <div className=\"p-6\">              <div className=\"flex items-center justify-between mb-4\">                <span className=\"inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold bg-primary/10 text-primary\">                  {contest.category}                </span>                <span className=\"text-sm text-muted-foreground\">                  {contest.metrics.totalVotes.toLocaleString()} votes                </span>              </div>              <h2 className=\"text-2xl font-semibold mb-2\">{contest.title}</h2>              <p className=\"text-muted-foreground mb-6\">{contest.description}</p>                            {contest.type === \'battle\' ? (                <LiveBattle contestId={contest.id} participants={contest.participants} userTrustScore={50} />              ) : (                <GroupVoting contestId={contest.id} participants={contest.participants} userTrustScore={50} />              )}            </div>          </div>        ))}      </div>    </div>  );}"
